# Copy this file to .env before running the app.

# Base URL of the Flask backend
VITE_API_URL=http://localhost:5000

# Google OAuth Client ID (Web application type) from the Google Cloud
# Console. Leave blank to disable the Google sign-in button.
VITE_GOOGLE_CLIENT_ID=

# Cloudflare Turnstile site key (public). Empty = widget hidden. Test key: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
