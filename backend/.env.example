# Copy this file to .env and fill in real values before running the app.

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rainchem
DB_USER=rainchem_app
DB_PASSWORD=rainchem_pass

# Used to sign JWTs and session tokens. Set this to a long random string.
SECRET_KEY=change-this-secret-key

# Public URL of the deployed frontend, no trailing slash. Used for CORS and for
# the links in emails (password reset). On Render set this to your Vercel URL,
# e.g. https://your-site.vercel.app . Several origins can be comma separated;
# the first one is used in email links.
FRONTEND_URL=http://localhost:5173

# Hours ahead of UTC used to group sales by day (Philippines = 8)
SALES_UTC_OFFSET_HOURS=8

# Outgoing email is sent through the Mailjet API (see app/services/email_service.py).
# Without these, emails are not sent and the reason is printed to the server log.
MAILJET_API_KEY=
MAILJET_API_SECRET=

# Legacy SMTP settings (SMTP_FROM is still the sender address) (verification, password reset, order
# notifications). If left blank, emails are written to the console and to
# the notifications table instead of actually being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Rainchem <no-reply@raincheminternational.com>

# Google Sign-In. Create an OAuth Client ID (type: Web application) in the
# Google Cloud Console and put it here and in the frontend .env as well.
GOOGLE_CLIENT_ID=
