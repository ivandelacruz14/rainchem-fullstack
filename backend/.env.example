# Copy this file to .env and fill in real values before running the app.

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rainchem
DB_USER=rainchem_app
DB_PASSWORD=rainchem_pass

# Used to sign JWTs and session tokens. Set this to a long random string.
SECRET_KEY=change-this-secret-key

# Frontend origin allowed to call this API (CORS). It is also the base of links in
# emails, such as the password reset link, so on Render set it to the public Vercel
# address, for example https://your-app.vercel.app (no localhost, no trailing path).
# Several origins can be listed separated by commas; the first one is used in emails.
FRONTEND_URL=http://localhost:5173

# Hours between UTC and the shop's local time, used to group sales reports by day.
# 8 is Philippine time.
STORE_UTC_OFFSET_HOURS=8

# Outgoing email (verification codes, password reset, order notifications) is sent
# through Mailjet. SMTP_FROM must be just the sender address that is verified in Mailjet.
# If these are blank, the email is not sent (the reason is printed in the server log).
MAILJET_API_KEY=
MAILJET_API_SECRET=
SMTP_FROM=no-reply@raincheminternational.com

# Google Sign-In. Create an OAuth Client ID (type: Web application) in the
# Google Cloud Console and put it here and in the frontend .env as well.
GOOGLE_CLIENT_ID=
